# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
!.yarn/sdks

# testing
/coverage
coverage
*.lcov
.nyc_output

# next.js
/.next/
/out/
.next
out

# production
/build
build/Release

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs
*.log
lerna-debug.log*

# env files (can opt-in for committing if needed)
.env*.local
.env
.env.*
!.env.example

# vercel
.vercel

# claude code (may cache secrets from approved commands)
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# runtime data
pids
*.pid
*.seed
*.pid.lock

# misc caches / package manager artifacts
lib-cov
.grunt
bower_components
.lock-wscript
jspm_packages/
web_modules/
.npm
.eslintcache
.stylelintcache
.node_repl_history
*.tgz
.yarn-integrity
.cache
.parcel-cache
.pnpm-store

# other framework build outputs (not used here, kept for safety)
.nuxt
dist
.output
.svelte-kit/
**/.vitepress/dist
**/.vitepress/cache
.docusaurus
.serverless/
.fusebox/
.dynamodb/
.firebase/
.tern-port
